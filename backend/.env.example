# CanonSync AI — Environment Variable Template
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=canonsync
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
# Required for IBM Granite text generation and embeddings.

# IAM API key from https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_iam_api_key

# Service URL for your region.
# US South:  https://us-south.ml.cloud.ibm.com
# EU DE:     https://eu-de.ml.cloud.ibm.com
# JP Tok:    https://jp-tok.ml.cloud.ibm.com
# AU Syd:    https://au-syd.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Project ID from your watsonx.ai project settings.
WATSONX_PROJECT_ID=your_watsonx_project_id

# ── IBM watsonx.ai — Optional overrides ──────────────────────────────────────
# These have sensible defaults. Only set them to override.

# Text generation model ID.
# Default: ibm/granite-3-8b-instruct
# WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Embedding model ID.
# Produces 384-dim vectors. Update EMBEDDING_DIMENSIONS and the
# database schema (VECTOR column) if you change this.
# Default: ibm/slate-30m-english-rtrvr-v2
# WATSONX_EMBED_MODEL=ibm/slate-30m-english-rtrvr-v2

# ── AI Pipeline — Optional tuning ────────────────────────────────────────────
# Expected embedding vector dimensions.
# IMPORTANT: this must match both the embedding model output AND
# the VECTOR(N) declaration in database/schema.sql.
# Default: 1536 (but IBM Slate models produce 384 or 768 — see AV-2 in the
# architecture verification report before enabling embeddings).
# EMBEDDING_DIMENSIONS=384

# Maximum number of similar canon facts to retrieve per query.
# SEMANTIC_SEARCH_TOP_K=10

# Minimum cosine similarity score to include in results (0.0–1.0).
# SEMANTIC_SEARCH_MIN_SIMILARITY=0.0

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * to allow all.
# CORS_ORIGIN=http://localhost:3000
